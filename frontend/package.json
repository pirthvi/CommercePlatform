{
  "name": "commerce-platform-frontend",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n STORE,ADMIN -c green,blue \"ng serve storefront --host 0.0.0.0\" \"ng serve admin --host 0.0.0.0 --port 4201\"",
    "start:storefront": "ng serve storefront --host 0.0.0.0",
    "start:admin": "ng serve admin --host 0.0.0.0 --port 4201",
    "build:storefront": "ng build storefront",
    "build:admin": "ng build admin"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3"
  }
}
